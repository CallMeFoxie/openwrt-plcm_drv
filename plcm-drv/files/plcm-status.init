#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

add_page() {
	local section="$1"
	local enabled name duration
	local line1_left line1_left_arg line1_right line1_right_arg
	local line2_left line2_left_arg line2_right line2_right_arg

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get name "$section" name "Page"
	config_get duration "$section" duration 5
	config_get line1_left "$section" line1_left none
	config_get line1_left_arg "$section" line1_left_arg ""
	config_get line1_right "$section" line1_right none
	config_get line1_right_arg "$section" line1_right_arg ""
	config_get line2_left "$section" line2_left none
	config_get line2_left_arg "$section" line2_left_arg ""
	config_get line2_right "$section" line2_right none
	config_get line2_right_arg "$section" line2_right_arg ""

	procd_append_param command --page "$name" "$duration" \
		"$line1_left" "$line1_left_arg" \
		"$line1_right" "$line1_right_arg" \
		"$line2_left" "$line2_left_arg" \
		"$line2_right" "$line2_right_arg"
}

start_service() {
	local device refresh

	config_load plcm-status
	config_get device main device /dev/plcm_drv
	config_get refresh main refresh 1

	procd_open_instance
	procd_set_param command /usr/sbin/plcm-status -d "$device" -r "$refresh"
	config_foreach add_page page
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger plcm-status
}