#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	local device interface refresh page_time

	config_load plcm-status
	config_get device main device /dev/plcm_drv
	config_get interface main interface eth0
	config_get refresh main refresh 2
	config_get page_time main page_time 5

	procd_open_instance
	procd_set_param command /usr/sbin/plcm-status \
		-d "$device" \
		-i "$interface" \
		-r "$refresh" \
		-p "$page_time"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger plcm-status
}