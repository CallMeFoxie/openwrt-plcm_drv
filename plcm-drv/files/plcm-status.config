config status 'main'
	option device '/dev/plcm_drv'
	option refresh '1'

config page
	option name 'Overview'
	option enabled '1'
	option duration '5'
	option line1_left 'hostname'
	option line1_right 'clock'
	option line2_left 'cpu'
	option line2_right 'ram'

config page
	option name 'Network'
	option enabled '1'
	option duration '5'
	option line1_left 'ipv4'
	option line1_left_arg 'br-lan'
	option line2_left 'rx'
	option line2_left_arg 'br-lan'
	option line2_right 'tx'
	option line2_right_arg 'br-lan'